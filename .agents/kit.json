{
  "kit": "0.2.0",
  "stack": "python",
  "commands": {
    "typecheck": "uv run pyright",
    "lint": "uv run ruff check",
    "test": "uv run pytest -q"
  },
  "models": {
    "plan": "opus",
    "implement": "sonnet",
    "review": "opus"
  },
  "maxIterations": 20,
  "handoffTokens": 80000,
  "launch": "claude --plugin-dir src/kit/plugin",
  "sandbox": { "image": "kit-sandbox" }
}
